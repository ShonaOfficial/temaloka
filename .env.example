# GEMINI_API_KEY: Required for Gemini Cloud AI & optional FreeLLMAPI failover.
GEMINI_API_KEY=""

# APP_URL: The public origin URL where TemaLoka is hosted.
APP_URL=""

# ADMIN_EMAIL & ADMIN_PASSWORD: Default Admin Panel (/?admin) credentials.
# Leave ADMIN_PASSWORD empty to set it securely on first run via /?admin UI.
ADMIN_EMAIL="shonatujuhbelasofficial@gmail.com"
ADMIN_PASSWORD=""

# SESSION_SECRET: HMAC key for signing session tokens (auto-generated if empty).
SESSION_SECRET=""

# CLOUDFLARE D1 REST API CONFIGURATION (optional; falls back to local SQLite if empty)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_D1_DATABASE_NAME="temaloka-db"
CLOUDFLARE_D1_BINDING="DB"
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_D1_WORKER_URL=""

# FREELLMAPI GATEWAY / PROVIDERS (OpenAI-compatible internal AI engine)
FREELLMAPI_BASE_URL=""
FREELLMAPI_API_KEY=""
FREELLMAPI_MODEL="auto"
GROQ_API_KEY=""
CEREBRAS_API_KEY=""
OPENROUTER_API_KEY=""
MISTRAL_API_KEY=""
NVIDIA_API_KEY=""
CLOUDFLARE_AI_TOKEN=""

# GOOGLE CLOUD CONSOLE (optional defaults; can also be managed via /?admin -> Google Cloud)
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_PROJECT_NUMBER=""
GOOGLE_CLOUD_REGION="asia-northeast1"
GOOGLE_OAUTH_CLIENT_ID=""

